# ---------------------------------------------------------------------------
# Natural-language Q&A (optional)
# ---------------------------------------------------------------------------
# Without this, /qa still works -- it returns the retrieved audit-trail rows
# directly instead of an LLM-phrased answer.
#
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Role keys (optional, but required to reach privileged endpoints)
# ---------------------------------------------------------------------------
# These gate the endpoints that consume compute, send data to a third-party
# LLM, or write to the ledger. They are verified SERVER-SIDE on every request.
#
# Leave a variable UNSET and that role becomes unreachable by anyone -- the
# default is fail-closed, not fail-open. Set them to any strong random string.
#
#   operator  ->  POST /run, POST /verification/run, POST /qa,
#                 GET /ledger/admin-log
#   admin     ->  everything above, plus POST /ledger/adjustments
#                 and POST /ledger/adjustments/reverse
#
# Send them as headers:  X-Sadhaka-Role: admin
#                        X-Sadhaka-Key:  <the value below>
SADHAKA_OPERATOR_KEY=
SADHAKA_ADMIN_KEY=
